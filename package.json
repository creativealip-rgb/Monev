{
  "name": "my-agent-finance",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_OPTIONS='--max-old-space-size=4096' next dev --webpack",
    "dev:clean": "npm run kill && npm run dev",
    "dev:reset": "npm run kill && npm run clean && npm run dev",
    "kill": "taskkill /F /IM node.exe",
    "clean": "rimraf .next node_modules/.cache",
    "build": "next build --webpack",
    "build:apk": "node scripts/build-apk.js",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:prod": "drizzle-kit migrate --config=drizzle.config.prod.ts",
    "db:seed:coupons": "tsx scripts/seed-coupons.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.1.0",
    "@capacitor/app": "^8.0.1",
    "@capacitor/cli": "^8.1.0",
    "@capacitor/core": "^8.1.0",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/keyboard": "^8.0.0",
    "@capacitor/network": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.1",
    "@ducanh2912/next-pwa": "^10.2.9",
    "@napi-rs/canvas": "^0.1.96",
    "@tanstack/react-query": "^5.90.21",
    "@types/bcryptjs": "^2.4.6",
    "ai": "^6.0.79",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.6.2",
    "capacitor-native-biometric": "^4.2.2",
    "capacitor-notifications-listener": "^0.5.0",
    "chart.js": "^4.5.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.1",
    "drizzle-zod": "^0.8.3",
    "framer-motion": "^12.34.0",
    "idb": "^8.0.3",
    "jose": "^6.2.1",
    "jspdf": "^4.2.0",
    "jspdf-autotable": "^5.0.7",
    "lottie-react": "^2.4.1",
    "lucide-react": "^0.563.0",
    "next": "16.1.6",
    "next-auth": "^5.0.0-beta.30",
    "openai": "^6.21.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-intersection-observer": "^10.0.3",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.0",
    "resend": "^6.9.2",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.4.0",
    "uc.micro": "^2.1.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/resolve": "^1.20.6",
    "@types/trusted-types": "^2.0.7",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.9",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.21.0",
    "typescript": "^5",
